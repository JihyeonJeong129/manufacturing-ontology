# ===== App =====
APP_NAME=fastapi-app
# development | production
APP_ENV=development
DEBUG=true
# 호스트에 노출할 FastAPI 포트
API_PORT=8000
TZ=Asia/Seoul

# ===== PostgreSQL =====
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=app_db
# compose 서비스명 (컨테이너 간 통신용 호스트명)
POSTGRES_HOST=db
# 컨테이너 내부 포트
POSTGRES_PORT=5432
# 호스트에 노출할 DB 포트
DB_EXPOSE_PORT=5432
# SQL 로그 출력 (원본 payload가 로그에 남을 수 있으므로 기본 false)
DB_ECHO=false

# ===== RSW 지식/처리 설정 (모두 선택, 기본값 있음) =====
# 활성 지식 배포본을 가리키는 knowledge_deployments.name
KNOWLEDGE_DEPLOYMENT=pilot
# 원본 PDF, RDF 스냅샷 저장 위치 (compose에서는 app_storage 볼륨)
# STORAGE_ROOT=/data/storage
# 워커 설정
WORKER_POLL_INTERVAL_SECONDS=1.0
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3

# ===== 데모 시드용 토큰 (python -m app.cli seed-demo 에서만 사용) =====
# 합성 데모 데이터와 함께 등록되는 Bearer 토큰. 실제 운영 토큰으로 사용하지 않는다.
DEMO_ML_TOKEN=demo-ml-token-change-me
DEMO_OPERATOR_TOKEN=demo-operator-token-change-me
DEMO_REVIEWER_TOKEN=demo-reviewer-token-change-me

# ===== RSW MVP 실제 지식 (python -m app.cli load-mvp) =====
# 원본 문서 폴더(호스트 경로). 컨테이너에는 /data/raw로 읽기 전용 마운트된다.
# RAW_DATA_HOST_DIR=../RAW Data
# 벡터 검색: local(이미지에 포함된 multilingual-e5-small) | none
# EMBEDDING_BACKEND=local
# RSW MVP 적재와 함께 등록되는 Bearer 토큰. 실제 운영 토큰으로 사용하지 않는다.
MVP_ML_TOKEN=rsw-ml-token-change-me
MVP_OPERATOR_TOKEN=rsw-operator-token-change-me
MVP_REVIEWER_TOKEN=rsw-reviewer-token-change-me

# ===== pgAdmin (docker compose --profile tools up -d pgadmin) =====
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password
# 127.0.0.1에만 바인딩된다
PGADMIN_PORT=5050
